; zrrtc.z80 - RTCNIT de TurboDOS 1.3 para la Z80-Retro / ZEPHYRUS
; (C) OLIVEROS 2026
;
; Lee el DS1307 (I2C por software en los puertos 64h/65h) al arrancar y pone
; la fecha y la hora en las variables de RTCMGR:
;   SECS, MINS, HOURS  binario (0-59, 0-59, 0-23)
;   JDATE              dias desde el 31-dic-1947 (1 = 1-ene-1948)
; Si el reloj no responde o la fecha no tiene sentido, no toca nada y
; TurboDOS queda con su fecha de "sin poner".
;
; ZRSDT: cuando se pone la fecha o la hora (T-funcion 9, C-funcion 104, el
; comando DATE), tambien se escribe en el DS1307. El .PAR cambia el final de
; SDTFCN (RTCMGR) para que salte aqui:
;   SDTFCN + 0F = 0C3,ZRSDT     (en lugar de LD (SECS),A / RET)
;
; RTCNIT va en ?INIT? (corre una vez); ZRSDT y el I2C quedan residentes.

        public  RTCNIT,ZRSDT
        extern  SECS,MINS,HOURS,JDATE

I2CP    equ     64h
I2CDATA equ     02h

        common  /?INIT?/

RTCNIT: ld      a,3             ; I2C en reposo (SDA y SCL arriba)
        ld      (IVAL),a
        ld      a,I2CP
        ld      (ICLKP),a
        call    RDRTC
        ret     c                       ; no responde
        ld      a,(RG+0)
        and     7Fh                     ; bit 7 = reloj detenido
        call    BCDBIN
        cp      60
        ret     nc
        ld      (SS),a
        ld      a,(RG+1)
        call    BCDBIN
        cp      60
        ret     nc
        ld      (MM),a
        ld      a,(RG+2)
        and     3Fh                     ; modo de 24 horas
        call    BCDBIN
        cp      24
        ret     nc
        ld      (HH),a
        ld      a,(RG+4)
        call    BCDBIN                  ; dia 1-31
        or      a
        ret     z
        cp      32
        ret     nc
        ld      (DD),a
        ld      a,(RG+5)
        call    BCDBIN                  ; mes 1-12
        or      a
        ret     z
        cp      13
        ret     nc
        ld      (MO),a
        ld      a,(RG+6)
        call    BCDBIN                  ; anio 00-99 (2000-2099)
        cp      100
        ret     nc
        ld      (YY),a
; dias = 365*(Y-1948) + (Y-1948+3)/4 + dias antes del mes + dia
;        + 1 si el anio es bisiesto y el mes es mayor que febrero
        add     a,52                    ; n = Y-1948
        ld      l,a
        ld      h,0
        push    hl
        ld      de,365
        call    MUL16                   ; HL = n*365
        pop     de
        inc     de
        inc     de
        inc     de
        srl     e                       ; (n+3)/4, n+3 < 256
        srl     e
        add     hl,de
        ld      a,(MO)
        dec     a
        add     a,a
        ld      e,a
        ld      d,0
        push    hl
        ld      hl,MTAB
        add     hl,de
        ld      e,(hl)
        inc     hl
        ld      d,(hl)
        pop     hl
        add     hl,de
        ld      a,(DD)
        ld      e,a
        ld      d,0
        add     hl,de
        ld      a,(YY)
        and     3
        jr      nz,RT1                  ; no bisiesto
        ld      a,(MO)
        cp      3
        jr      c,RT1
        inc     hl
RT1:    ld      (JDATE),hl
        ld      a,(SS)
        ld      (SECS),a
        ld      a,(MM)
        ld      (MINS),a
        ld      a,(HH)
        ld      (HOURS),a
        ret

        cseg
; ZRSDT: A = segundos (lo que guardaba SDTFCN), JDATE, HOURS y MINS ya estan
ZRSDT:  ld      (SECS),a
        push    ix
        call    J2YMD           ; JDATE -> YY, MO, DD
        ld      a,(SECS)
        call    BINBCD
        ld      (RG+0),a        ; bit 7 = 0: el reloj anda
        ld      a,(MINS)
        call    BINBCD
        ld      (RG+1),a
        ld      a,(HOURS)
        call    BINBCD
        ld      (RG+2),a        ; modo de 24 horas
        ld      a,(DW)
        ld      (RG+3),a
        ld      a,(DD)
        call    BINBCD
        ld      (RG+4),a
        ld      a,(MO)
        call    BINBCD
        ld      (RG+5),a
        ld      a,(YY)
        call    BINBCD
        ld      (RG+6),a
        call    WRRTC
        pop     ix
        ret

; J2YMD: JDATE (1 = 1-ene-1948) -> YY (anio - 2000, o - 1900), MO, DD, DW
; (dia de la semana 1-7, 1 = domingo; el 1-ene-1948 fue jueves)
J2YMD:  ld      hl,(JDATE)
        push    hl
        ld      de,3
        add     hl,de
        ld      c,7
        call    DIV8            ; A = (JDATE + 3) mod 7
        inc     a
        ld      (DW),a
        pop     hl
        ld      b,48            ; anio - 1900
JY1:    ld      de,365
        ld      a,b
        and     3
        jr      nz,JY2
        inc     de              ; bisiesto (1948-2099)
JY2:    or      a
        sbc     hl,de           ; quedan mas dias que el anio?
        jr      z,JY3
        jr      c,JY3
        inc     b
        jr      JY1
JY3:    add     hl,de           ; HL = dia del anio (1-366)
        ld      a,b
        sub     100
        jr      nc,JY4
        add     a,100
JY4:    ld      (YY),a
        ld      ix,MLEN
        ld      c,1             ; mes
JY5:    ld      e,(ix+0)
        ld      d,0
        ld      a,c
        cp      2
        jr      nz,JY6
        ld      a,b
        and     3
        jr      nz,JY6
        inc     e               ; febrero bisiesto
JY6:    or      a
        sbc     hl,de
        jr      z,JY7
        jr      c,JY7
        inc     ix
        inc     c
        jr      JY5
JY7:    add     hl,de
        ld      a,l
        ld      (DD),a
        ld      a,c
        ld      (MO),a
        ret

; DIV8: A = HL mod C (C < 128)
DIV8:   ld      b,16
        xor     a
DV1:    add     hl,hl
        rla
        cp      c
        jr      c,DV2
        sub     c
        inc     l
DV2:    djnz    DV1
        ret

; BINBCD: A (0-99) -> BCD
BINBCD: ld      b,0
BB1:    cp      10
        jr      c,BB2
        sub     10
        inc     b
        jr      BB1
BB2:    sla     b
        sla     b
        sla     b
        sla     b
        or      b
        ret

MLEN:   defb    31,28,31,30,31,30,31,31,30,31,30,31

; WRRTC: los 7 registros de RG al DS1307 (desde el registro 0)
WRRTC:  call    ISTART
        ld      a,0D0h
        call    IWBY
        or      a
        jr      nz,WR9
        xor     a
        call    IWBY
        ld      hl,RG
        ld      b,7
WR1:    ld      a,(hl)
        call    IWBY
        inc     hl
        djnz    WR1
WR9:    jp      ISTOP

; HL = HL * DE (16 bits)
MUL16:  ld      b,h
        ld      c,l
        ld      hl,0
        ld      a,16
MU1:    add     hl,hl
        ex      de,hl
        add     hl,hl
        ex      de,hl
        jr      nc,MU2
        add     hl,bc
MU2:    dec     a
        jr      nz,MU1
        ret

; A (BCD) -> A (binario)
BCDBIN: push    bc
        ld      c,a
        and     0F0h
        rrca
        ld      b,a                     ; decenas*8
        rrca
        rrca                            ; decenas*2
        add     a,b                     ; decenas*10
        ld      b,a
        ld      a,c
        and     0Fh
        add     a,b
        pop     bc
        ret

MTAB:   defw    0,31,59,90,120,151,181,212,243,273,304,334

; RDRTC: los 7 registros del DS1307 en RG. CY si no responde.
RDRTC:  ld      a,3
        ld      (IVAL),a
        out     (I2CP+1),a
        call    ISTART
        ld      a,0D0h
        call    IWBY
        or      a
        scf
        jr      nz,RD9
        xor     a
        call    IWBY
        call    ISTART
        ld      a,0D1h
        call    IWBY
        ld      hl,RG
        ld      b,7
RD1:    ld      a,b
        dec     a                       ; ACK salvo en el ultimo
        ld      a,0
        jr      nz,RD2
        inc     a
RD2:    call    IRBY
        ld      (hl),a
        inc     hl
        djnz    RD1
        or      a
RD9:    push    af
        call    ISTOP
        pop     af
        ret

IDLY:   push    bc
        ld      b,3
IDL1:   djnz    IDL1
        pop     bc
        ret
ISTART: ld      a,1
        call    ICLK
        ld      a,1
        call    IDAT
        call    IDLY
        xor     a
        call    IDAT
        call    IDLY
        xor     a
        call    ICLK
        jp      IDLY
ISTOP:  xor     a
        call    IDAT
        call    IDLY
        ld      a,1
        call    ICLK
        call    IDLY
        ld      a,1
        call    IDAT
        call    IDLY
        xor     a
        call    ICLK
        jp      IDLY
IWBI:   call    IDAT
        call    IDLY
        ld      a,1
        call    ICLK
        call    IDLY
        xor     a
        call    ICLK
        jp      IDLY
IWBY:   push    bc                      ; manda A; devuelve el bit ACK (0 = reconocido)
        ld      b,8
        ld      c,a
IW1:    rlc     c
        ld      a,c
        call    IWBI
        djnz    IW1
        call    IRBI
        pop     bc
        ret
IRBI:   ld      a,1
        call    IDAT
        call    IDLY
        ld      a,1
        call    ICLK
        call    IDLY
        in      a,(I2CP)
        and     I2CDATA
        push    af
        xor     a
        call    ICLK
        call    IDLY
        pop     af
        sra     a
        ret
IRBY:   push    bc                      ; A = bit a mandar despues (0 ACK, 1 NACK)
        push    af
        ld      c,0
        ld      b,8
IR1:    ld      a,c
        add     a,a
        ld      c,a
        call    IRBI
        or      c
        ld      c,a
        djnz    IR1
        pop     af
        call    IWBI
        ld      a,c
        pop     bc
        ret
IDAT:   push    bc
        and     1
        ld      a,(ICLKP)
        ld      c,a
        ld      a,(IVAL)
        jr      z,ID1
        or      I2CDATA
        jr      ID2
ID1:    and     0FFh-I2CDATA
ID2:    ld      (IVAL),a
        out     (c),a
        pop     bc
        ret
ICLK:   push    bc
        rrca
        ld      a,I2CP
        adc     a,0
        ld      (ICLKP),a
        ld      c,a
        ld      a,(IVAL)
        out     (c),a
        pop     bc
        ret

        dseg
IVAL:   defb    3
ICLKP:  defb    I2CP
RG:     defs    7
SS:     defb    0
MM:     defb    0
HH:     defb    0
DD:     defb    0
MO:     defb    0
YY:     defb    0
DW:     defb    0

        end

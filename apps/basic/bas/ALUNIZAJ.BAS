10 REM ALUNIZAJE - Z80-RETRO
20 H=600:V=30:F=150:T=0
30 PRINT:PRINT "BAJAS A LA LUNA DESDE 600 M A 30 M/S."
40 PRINT "CADA SEGUNDO QUEMAS DE 0 A 30 KG. LA GRAVEDAD SUMA"
50 PRINT "2 M/S, CADA KG RESTA 0.5. TOCA SUELO A MENOS DE 5."
60 PRINT:PRINT "T";T;" ALT";INT(H);" VEL";INT(V*10)/10;" COMB";F
70 INPUT "QUEMAR";B:IF B<0 OR B>30 THEN 70
80 IF B>F THEN B=F:PRINT "SOLO QUEDABAN";F
90 F=F-B:A=2-B/2:H=H-V-A/2:V=V+A:T=T+1
100 IF H>0 THEN 60
110 PRINT:PRINT "CONTACTO A";INT(V*10)/10;"M/S EN";T;"SEGUNDOS."
120 IF V<5 THEN PRINT "ALUNIZAJE PERFECTO!":GOTO 150
130 IF V<15 THEN PRINT "ATERRIZAJE DURO: NAVE ABOLLADA.":GOTO 150
140 PRINT "NUEVO CRATER DE";INT(V/3);"METROS DE ANCHO."
150 INPUT "OTRA VEZ (S/N)";A$:IF A$="S" THEN 20

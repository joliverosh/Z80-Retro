10 REM PIEDRA, PAPEL O TIJERA - Z80-RETRO
20 GOSUB 9000:G=0:P=0
30 PRINT:INPUT "1 PIEDRA, 2 PAPEL, 3 TIJERA (0 TERMINA)";J
40 IF J=0 THEN PRINT "TU";G;" YO";P:END
50 IF J<1 OR J>3 THEN 30
60 C=INT(RND(1)*3)+1:PRINT "YO: ";MID$("PIEDRAPAPEL TIJERA",C*6-5,6)
70 R=J-C+3:R=R-3*INT(R/3)
80 IF R=0 THEN PRINT "EMPATE.":GOTO 30
90 IF R=1 THEN PRINT "GANASTE.":G=G+1:GOTO 30
100 PRINT "GANE YO.":P=P+1:GOTO 30
9000 PRINT "(PULSA ENTER)";:S=0
9010 S=S+1:IF S>32000 THEN S=-32000
9020 IF INKEY$="" THEN 9010
9030 PRINT:RANDOMIZE S:RETURN

10 REM LOS PALITOS - Z80-RETRO
20 GOSUB 9000
30 PRINT:PRINT "SACAMOS 1, 2 O 3 PALITOS POR TURNO."
40 PRINT "QUIEN SACA EL ULTIMO PIERDE. EMPIEZAS TU."
50 N=INT(RND(1)*10)+15
60 PRINT:PRINT "QUEDAN";N;": ";:FOR I=1 TO N:PRINT "I";:NEXT I:PRINT
70 INPUT "CUANTOS SACAS";P:P=INT(P)
80 IF P<1 OR P>3 OR P>N THEN PRINT "NO SE PUEDE.":GOTO 70
90 N=N-P:IF N=0 THEN PRINT "SACASTE EL ULTIMO: GANO YO.":GOTO 140
100 C=N-1-4*INT((N-1)/4):IF C=0 THEN C=INT(RND(1)*3)+1
110 IF C>N THEN C=N
120 PRINT "YO SACO";C:N=N-C
125 IF N=0 THEN PRINT "SAQUE EL ULTIMO. GANASTE!":GOTO 140
130 GOTO 60
140 INPUT "OTRA (S/N)";A$:IF A$="S" THEN 50
9000 PRINT "(PULSA ENTER)";:S=0
9010 S=S+1:IF S>32000 THEN S=-32000
9020 IF INKEY$="" THEN 9010
9030 PRINT:RANDOMIZE S:RETURN

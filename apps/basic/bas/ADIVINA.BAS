10 REM ADIVINA EL NUMERO - Z80-RETRO
20 GOSUB 9000
30 PRINT:PRINT "PIENSO UN NUMERO DEL 1 AL 100."
40 N=INT(RND(1)*100)+1:T=0
50 INPUT "TU NUMERO";G:T=T+1
60 IF G<N THEN PRINT "MAS ALTO.":GOTO 50
70 IF G>N THEN PRINT "MAS BAJO.":GOTO 50
80 PRINT "ACERTASTE EN";T;"INTENTOS!"
90 INPUT "OTRA VEZ (S/N)";A$:IF A$="S" THEN 30
9000 PRINT "(PULSA ENTER)";:S=0
9010 S=S+1:IF S>32000 THEN S=-32000
9020 IF INKEY$="" THEN 9010
9030 PRINT:RANDOMIZE S:RETURN

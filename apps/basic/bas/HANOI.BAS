10 REM TORRES DE HANOI - Z80-RETRO
20 PRINT:INPUT "CUANTOS DISCOS (1-7)";N:IF N<1 OR N>7 THEN 20
30 P$="ABC":IF N/2=INT(N/2) THEN P$="ACB"
40 M=1:FOR I=1 TO N:M=M*2:NEXT I:M=M-1
50 PRINT "PASAR LA TORRE DE A A C:";M;"MOVIDAS"
60 FOR K=1 TO M:D=1:J=K
70 IF J/2=INT(J/2) THEN J=J/2:D=D+1:GOTO 70
80 F=K AND K-1:F=F-3*INT(F/3):T=(K OR K-1)+1:T=T-3*INT(T/3)
90 PRINT K;"DISCO";D;"DE ";MID$(P$,F+1,1);" A ";MID$(P$,T+1,1)
100 NEXT K
